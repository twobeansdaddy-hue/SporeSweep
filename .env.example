# 공용 키는 ~/.config/agentic-kit/.env 에 한 번만 넣으면 모든 프로젝트가 씁니다 (setup-mac.sh가 만들어 줌).
# 이 파일은 프로젝트마다 다른 값이 필요할 때만 .env로 복사해서 쓰세요. 프로젝트 .env가 공용 파일보다 우선하고,
# 비워 둔 항목은 공용 파일 값을 씁니다. .env는 커밋하지 않습니다.

# 결정 모델 기본값: Cloudflare Workers AI의 Clef-flash
# 대시보드 → Workers AI → "Use REST API"에서 계정 ID와 토큰(Workers AI Read/Edit 권한)을 만듭니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# (선택) TypeSafe Jev — 대기자 명단 승인 후
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# (선택) OpenRouter 경유 Jev
OPENROUTER_API_KEY=

# (선택) 로컬 Laya 등 Jev 호환 서버의 System One 엔드포인트 전체 URL
# DECIDE_LOCAL_URL=http://localhost:8888/v1/systemone
# DECIDE_LOCAL_KEY=
