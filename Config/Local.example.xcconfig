// 이 파일을 Local.xcconfig로 복사해서 자기 값을 적는다. Local.xcconfig는 저장소에 올리지 않는다.

// Apple 개발 팀 ID. 실제 기기에 설치하려면 필요하다(Xcode → Settings → Accounts에서 확인).
DEVELOPMENT_TEAM = XXXXXXXXXX

// AdMob에 등록한 앱 ID와 보상형 광고 단위 ID. 적지 않으면 시험용 ID를 쓴다.
// GAD_APPLICATION_ID = ca-app-pub-0000000000000000~0000000000
// REWARDED_AD_UNIT_ID = ca-app-pub-0000000000000000/0000000000
